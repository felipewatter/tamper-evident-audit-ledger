{
  "name": "tamper-evident-audit-ledger",
  "version": "0.1.0",
  "description": "Tamper-evident (hash-chained) audit log for Node.js/TypeScript with optional Ed25519 signatures + CLI verifier.",
  "license": "MIT",
  "author": "Felipe Watter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipewatter/tamper-evident-audit-ledger.git"
  },
  "bugs": {
    "url": "https://github.com/felipewatter/tamper-evident-audit-ledger/issues"
  },
  "homepage": "https://github.com/felipewatter/tamper-evident-audit-ledger#readme",
  "keywords": [
    "security",
    "audit",
    "logging",
    "tamper-evident",
    "hash-chain",
    "ed25519",
    "devsecops",
    "typescript"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "audit-ledger": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/postbuild.js",
    "dev": "tsc -w -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier -w .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "audit:deps": "npm audit --audit-level=high"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
